# =============================================================
#  Deepay Webhook Server — systemd 服务单元
#
#  ⚠️  不需要手动编辑此文件。
#     bootstrap.sh 会自动安装并替换所有路径和 Secret。
#
#  手动安装（若需要）：
#       bash /www/wwwroot/deepaystudio/script/shell/bootstrap.sh
#
#  查看状态 & 日志：
#       systemctl status deepay-webhook
#       journalctl -u deepay-webhook -f
#       tail -f /www/wwwroot/deepaystudio/.build-logs/webhook.log
#
#  GitHub Webhook 配置：
#       Payload URL : http://<服务器IP>:9000/webhook
#       Content type: application/json
#       Secret      : 见 /root/.deepay_webhook_secret
#       Events      : Just the push event
# =============================================================
[Unit]
Description=Deepay GitHub Webhook Auto-Deploy Server
Documentation=https://github.com/deepay999/deepaystudio
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/www/wwwroot/deepaystudio

# ── bootstrap.sh 自动替换此值 ────────────────────────────────
Environment=WEBHOOK_SECRET=change-me-to-your-github-webhook-secret

# ── 配置 ─────────────────────────────────────────────────────
Environment=WEBHOOK_PORT=9000
Environment=WEBHOOK_BRANCH=main
Environment=WEBHOOK_MODE=all
Environment=PROJECT_ROOT=/www/wwwroot/deepaystudio
Environment=WEBHOOK_DEPLOY=/www/wwwroot/deepaystudio/script/shell/deepay-deploy.sh
Environment=WEBHOOK_LOG_DIR=/www/wwwroot/deepaystudio/.build-logs

ExecStart=/usr/bin/python3 /www/wwwroot/deepaystudio/script/shell/webhook.py run

Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

StandardOutput=append:/www/wwwroot/deepaystudio/.build-logs/webhook.log
StandardError=append:/www/wwwroot/deepaystudio/.build-logs/webhook.log

[Install]
WantedBy=multi-user.target
